      },
      {
        "category": "idiom",
        "title": null,
        "dynasty": null,
        "author": null,
        "content": "明眸皓齿"
      },
      {
        "category": "idiom",
        "title": null,
        "dynasty": null,
        "author": null,
        "content": "文质彬彬"
      },
      {
        "category": "idiom",
        "title": null,
        "dynasty": null,
        "author": null,
        "content": "相貌堂堂"
      },
      {
        "category": "idiom",
        "title": null,
        "dynasty": null,
        "author": null,
        "content": "威风凛凛"
      },
      {
        "category": "idiom",
        "title": null,
        "dynasty": null,
        "author": null,
        "content": "膀大腰圆"
      },
      {
        "category": "idiom",
        "title": null,
        "dynasty": null,
        "author": null,
        "content": "浓眉大眼"
      },
      {
        "category": "idiom",
        "title": null,
        "dynasty": null,
        "author": null,
        "content": "白发苍苍"
      },
      {
        "category": "idiom",
        "title": null,
        "dynasty": null,
        "author": null,
        "content": "鹤发童颜"
      },
      {
        "category": "idiom",
        "title": null,
        "dynasty": null,
        "author": null,
        "content": "慈眉善目"
      },
      {
        "category": "idiom",
        "title": null,
        "dynasty": null,
        "author": null,
        "content": "步履蹒跚"
      }
    ]
  }
]
