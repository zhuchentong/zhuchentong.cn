---
import ChineseLayout from '@chinese/layout.astro'
---

<ChineseLayout title="语文学习">
  <div class="flex h-full items-center justify-center p-6">
    <div class="grid w-full max-w-3xl gap-4 sm:grid-cols-2">
      <a
        href="/chinese/gallery"
        class="group flex flex-col gap-2 rounded-xl border border-border bg-card p-6 transition-all hover:border-foreground/20 hover:shadow-md"
      >
        <div class="text-3xl font-bold">打字练习</div>
        <p class="text-sm text-muted-foreground">选择教材与课文，练习词语和生字的拼音拼写</p>
        <div class="mt-2 text-sm text-primary opacity-0 transition-opacity group-hover:opacity-100">开始 →</div>
      </a>
      <div class="flex flex-col gap-2 rounded-xl border border-dashed border-border p-6 text-muted-foreground">
        <div class="text-3xl font-bold">更多功能</div>
        <p class="text-sm">建设中…</p>
      </div>
    </div>
  </div>
</ChineseLayout>
