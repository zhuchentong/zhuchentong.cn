---
import BaseLayout from '@/layouts/BaseLayout.astro'
import ThemeToggle from '@/components/widgets/ThemeToggle.tsx'
import CyberScene from '@/components/home/CyberScene.tsx'

const cards = [
  {
    href: '/copybook/hanzi',
    tag: 'copybook',
    title: '字帖',
    desc: '生成汉字田字格、米字格描红字帖',
  },
  {
    href: '/workbook/pinyin',
    tag: 'workbook',
    title: '练习册',
    desc: '拼音声母韵母练习题生成',
  },
  {
    href: '/english',
    tag: 'english',
    title: '单词',
    desc: '英语单词与课文句子学习',
  },
  {
    href: '/chinese',
    tag: 'chinese',
    title: '语文',
    desc: '中文词语与生字拼音打字练习',
  },
  {
    href: '/history/dynasty',
    tag: 'history',
    title: '历史朝代',
    desc: '多文明历史朝代时间轴对比',
  },
]
---

<BaseLayout title="首页" description="给孩子的学习小工具：字帖、练习册、英语单词、语文打字、历史朝代">
  <div class="cyber">
    <!-- WebGL 不可用时的静态磷光渐变降级背景 -->
    <div class="cyber-fallback" aria-hidden="true"></div>

    <!-- Three.js 终端骇客 3D 场景 -->
    <CyberScene client:load />

    <!-- CRT 覆盖层：暗角 + 全局扫描线 -->
    <div class="cyber-overlay" aria-hidden="true"></div>

    <!-- 极简终端导航 -->
    <nav class="cyber-nav">
      <a href="/" class="cyber-logo">[ 前端小馆 ]</a>
      <div class="cyber-theme"><ThemeToggle client:load /></div>
    </nav>

    <main class="cyber-main">
      <!-- Hero：终端打字机 -->
      <header class="cyber-hero rise">
        <p class="term-line type-target" data-type="$ whoami"></p>
        <h1 class="cyber-title type-target" data-type="前端小馆"></h1>
        <p class="term-line type-target" data-type="$ ls ./tools --for-kids"></p>
        <p class="cyber-subtitle type-target" data-type="给孩子的学习小工具"></p>
        <span class="caret" aria-hidden="true">▊</span>
      </header>

      <!-- 功能入口：单卡 3D 翻转轮播（无 JS 时退化为网格） -->
      <section class="card-viewer rise" aria-roledescription="轮播" aria-label="功能入口">
        <div class="card-stage" data-tilt-stage>
          {
            cards.map((card, i) => (
              <a
                href={card.href}
                class="cyber-card power-on"
                data-card
                data-tilt
                aria-hidden={i > 0 ? 'true' : 'false'}
                tabindex={i > 0 ? -1 : 0}
                style={`--stagger: ${400 + i * 60}ms`}
              >
                <span class="card-tag" aria-hidden="true">{`[0${i + 1} // ${card.tag}]`}</span>
                <h2>{card.title}</h2>
                <p>{card.desc}</p>
                <span class="card-cta">
                  进入{' '}
                  <span class="arrow" aria-hidden="true">
                    →
                  </span>
                </span>
              </a>
            ))
          }
        </div>

        <div class="viewer-controls">
          <button class="viewer-btn" type="button" data-prev aria-label="上一项">‹</button>
          <span class="viewer-indicator">
            <span id="viewer-cur">01</span>
            <span class="indicator-sep">/</span>
            <span>{`0${cards.length}`}</span>
          </span>
          <button class="viewer-btn" type="button" data-next aria-label="下一项">›</button>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  // 交互逻辑：打字机 Hero / 卡片 tilt / 单卡翻转轮播
  import '@/scripts/home'
</script>

<style>
  /* ========== 主页固定为终端骇客深色：覆盖主题变量，不受站点 light/dark 影响 ========== */
  .cyber {
    --background: #020604;
    --foreground: #c9f7d1;
    --muted-foreground: #63936f;
    --primary: #00ff41;
    --amber: #ffb000;

    position: relative;
    min-height: 100svh;
    overflow: clip;
    background: var(--background);
    color: var(--foreground);
    font-family: ui-monospace, 'JetBrains Mono', 'Cascadia Mono', 'Source Code Pro', Consolas, monospace;
  }

  /* ========== 静态降级背景：WebGL 不可用或 JS 未执行时露出 ========== */
  .cyber-fallback {
    position: fixed;
    inset: 0;
    background:
      radial-gradient(ellipse 90% 55% at 50% 108%, rgb(0 255 65 / 10%), transparent 62%),
      radial-gradient(ellipse 72% 42% at 50% 112%, rgb(0 255 65 / 6%), transparent 66%),
      linear-gradient(#020604, #04120a 130%);
  }

  /* React 岛渲染的 DOM 没有 scoped cid，需用 :global() 匹配 */
  :global(.cyber-scene) {
    position: fixed;
    inset: 0;
  }

  :global(.cyber-scene canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* ========== CRT 覆盖层：暗角 + 绿调扫描线 ========== */
  .cyber-overlay {
    position: fixed;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 120% 90% at 50% 45%, transparent 52%, rgb(0 4 2 / 58%) 100%),
      repeating-linear-gradient(0deg, rgb(0 255 65 / 4%) 0 1px, transparent 1px 3px);
  }

  /* ========== 极简终端导航 ========== */
  .cyber-nav {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.5rem;
    padding: 0 clamp(1rem, 4vw, 2.5rem);
    border-bottom: 1px solid rgb(0 255 65 / 14%);
    background: rgb(2 6 4 / 55%);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .cyber-logo {
    font-size: 0.92rem;
    letter-spacing: 0.16em;
    color: var(--foreground);
    text-decoration: none;
    text-shadow: 0 0 12px rgb(0 255 65 / 45%);
    transition:
      text-shadow 0.25s,
      color 0.25s;
  }

  .cyber-logo:hover {
    color: var(--primary);
    text-shadow: 0 0 18px rgb(0 255 65 / 80%);
  }

  .cyber-theme {
    color: var(--muted-foreground);
  }

  .cyber-theme :global(svg) {
    width: 20px;
    height: 20px;
    transition: color 0.25s;
  }

  .cyber-theme :global(svg:hover) {
    color: var(--primary);
  }

  /* ========== 主内容 ========== */
  .cyber-main {
    position: relative;
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100svh;
    padding: 5.5rem 1.25rem 3rem;
  }

  /* ---------- Hero：终端打字机 ---------- */
  .cyber-hero {
    position: relative;
    text-align: center;
  }

  .term-line {
    font-size: clamp(0.85rem, 2vw, 1rem);
    letter-spacing: 0.08em;
    color: var(--muted-foreground);
  }

  /* $ 提示符高亮 */
  .term-line::first-letter {
    color: var(--primary);
    text-shadow: 0 0 10px rgb(0 255 65 / 80%);
  }

  .cyber-title {
    margin: 0.9rem 0;
    font-size: clamp(2.6rem, 8vw, 5rem);
    font-weight: 700;
    letter-spacing: 0.16em;
    color: #dcffe4;
    text-shadow:
      0 0 14px rgb(0 255 65 / 70%),
      0 0 44px rgb(0 255 65 / 38%),
      0 0 100px rgb(0 255 65 / 22%);
  }

  .cyber-subtitle {
    margin-top: 1rem;
    font-size: clamp(0.95rem, 2.2vw, 1.1rem);
    letter-spacing: 0.3em;
    color: var(--foreground);
    text-shadow: 0 0 16px rgb(0 255 65 / 30%);
  }

  /* 打字目标行：JS 启用后先隐藏再逐字显示 */
  :global(html.js) .type-target {
    opacity: 0;
    min-height: 1.5em;
  }

  :global(html.js) .type-target.typed-on {
    opacity: 1;
  }

  .caret {
    display: inline-block;
    color: var(--primary);
    text-shadow: 0 0 10px rgb(0 255 65 / 90%);
    animation: caret-blink 1.1s steps(1) infinite;
  }

  /* 光标挂在轮播控制条上时行内排布 */
  .viewer-controls .caret {
    margin-left: 0.6rem;
    font-size: 0.8rem;
  }

  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }

  /* ---------- 单卡轮播 ---------- */
  .card-viewer {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 30rem;
    margin-top: 2.75rem;
  }

  .card-stage {
    position: relative;
    width: 100%;
    perspective: 1100px;
  }

  .viewer-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .viewer-btn {
    padding: 0.15rem 0.85rem;
    border: 1px solid rgb(0 255 65 / 30%);
    border-radius: 0.25rem;
    background: rgb(0 255 65 / 4%);
    font-family: inherit;
    font-size: 1.15rem;
    line-height: 1.4;
    color: var(--primary);
    cursor: pointer;
    transition:
      border-color 0.25s,
      box-shadow 0.25s,
      background 0.25s;
  }

  .viewer-btn:hover,
  .viewer-btn:focus-visible {
    border-color: rgb(0 255 65 / 80%);
    background: rgb(0 255 65 / 10%);
    box-shadow: 0 0 16px rgb(0 255 65 / 30%);
    outline: none;
  }

  .viewer-indicator {
    min-width: 4.2rem;
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    color: var(--muted-foreground);
    text-align: center;
  }

  .viewer-indicator #viewer-cur {
    color: var(--primary);
    text-shadow: 0 0 8px rgb(0 255 65 / 70%);
  }

  .indicator-sep {
    margin: 0 0.3rem;
  }

  /* ---------- 卡片（终端窗口风格） ---------- */
  .cyber-card {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.9rem 2rem 1.7rem;
    border: 1px solid rgb(0 255 65 / 20%);
    border-radius: 0.5rem;
    background: linear-gradient(165deg, rgb(2 14 7 / 84%), rgb(1 6 3 / 94%));
    text-decoration: none;
    transform: translate3d(0, 0, 0);
    transform-style: preserve-3d;
    transition:
      border-color 0.35s,
      box-shadow 0.35s;
    will-change: transform;
    backface-visibility: hidden;
  }

  /* 磷光渐变描边：mask 挖空中心，只留 1px 渐变边 */
  .cyber-card::before {
    position: absolute;
    inset: 0;
    content: '';
    padding: 1px;
    border-radius: inherit;
    background: linear-gradient(135deg, rgb(0 255 65 / 85%), rgb(0 255 65 / 30%) 60%, rgb(255 176 0 / 40%));
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    opacity: 0.55;
    transition: opacity 0.35s;
    pointer-events: none;
  }

  /* 卡面扫描线纹理 */
  .cyber-card::after {
    position: absolute;
    inset: 0;
    content: '';
    border-radius: inherit;
    background: repeating-linear-gradient(0deg, transparent 0 3px, rgb(0 255 65 / 3.5%) 3px 4px);
    pointer-events: none;
  }

  .cyber-card:hover,
  .cyber-card:focus-visible {
    border-color: rgb(0 255 65 / 45%);
    box-shadow:
      0 0 26px rgb(0 255 65 / 18%),
      0 0 64px rgb(0 255 65 / 10%),
      inset 0 0 22px rgb(0 255 65 / 6%);
  }

  .cyber-card:hover::before,
  .cyber-card:focus-visible::before {
    opacity: 1;
  }

  .cyber-card:focus-visible {
    outline: 1px solid var(--primary);
    outline-offset: 4px;
  }

  .card-tag {
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    color: var(--primary);
    opacity: 0.85;
    text-shadow: 0 0 8px rgb(0 255 65 / 60%);
  }

  .cyber-card h2 {
    margin-top: 0.3rem;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: #e6ffee;
    text-shadow: 0 0 14px rgb(0 255 65 / 35%);
  }

  .cyber-card p {
    font-size: 0.88rem;
    line-height: 1.7;
    letter-spacing: 0.04em;
    color: var(--muted-foreground);
  }

  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1rem;
    font-size: 0.82rem;
    letter-spacing: 0.2em;
    color: var(--amber);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.3s,
      transform 0.3s;
  }

  .cyber-card:hover .card-cta,
  .cyber-card:focus-visible .card-cta {
    opacity: 1;
    transform: translateX(0);
  }

  .arrow {
    transition: translate 0.3s;
  }

  .cyber-card:hover .arrow {
    translate: 3px 0;
  }

  /* ---------- 轮播模式（JS 启用后）：卡片堆叠，仅当前卡占位 ---------- */
  .card-viewer.viewer-on .card-stage [data-card] {
    position: absolute;
    inset: 0;
    visibility: hidden;
  }

  .card-viewer.viewer-on .card-stage [data-card].is-active {
    position: relative;
    visibility: visible;
  }

  /* 接力翻转：旧卡转到侧立（forwards 保持姿态），新卡从侧立翻正；侧立瞬间换手，观感为一张卡连续翻转 */
  .card-viewer.viewer-on .card-stage [data-card].flip-in-right {
    animation: flip-in-right 0.22s ease-out backwards;
  }

  .card-viewer.viewer-on .card-stage [data-card].flip-in-left {
    animation: flip-in-left 0.22s ease-out backwards;
  }

  .card-viewer.viewer-on .card-stage [data-card].flip-out-left {
    animation: flip-out-left 0.18s ease-in forwards;
  }

  .card-viewer.viewer-on .card-stage [data-card].flip-out-right {
    animation: flip-out-right 0.18s ease-in forwards;
  }

  @keyframes flip-out-left {
    to {
      transform: rotateY(90deg);
    }
  }

  @keyframes flip-out-right {
    to {
      transform: rotateY(-90deg);
    }
  }

  @keyframes flip-in-right {
    from {
      transform: rotateY(-90deg);
    }
  }

  @keyframes flip-in-left {
    from {
      transform: rotateY(90deg);
    }
  }

  /* ---------- 入场动画 ---------- */
  .rise {
    animation: rise 0.9s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.2rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* 逐张「通电」：闪烁感入场（只动 opacity/filter，不占用 transform 以免与 tilt 冲突） */
  .power-on {
    opacity: 0;
    animation: power-on 0.9s ease-out forwards;
    animation-delay: var(--stagger, 0ms);
  }

  @keyframes power-on {
    0% {
      opacity: 0;
      filter: brightness(2.6);
    }
    30% {
      opacity: 1;
    }
    36% {
      opacity: 0.25;
      filter: brightness(1.8);
    }
    48% {
      opacity: 1;
    }
    55% {
      opacity: 0.5;
    }
    100% {
      opacity: 1;
      filter: brightness(1);
    }
  }

  .card-viewer.rise {
    animation-delay: 220ms;
  }

  /* ========== 降级：减少动态效果 ========== */
  @media (prefers-reduced-motion: reduce) {
    .rise,
    .power-on,
    .flip-out-left,
    .flip-out-right,
    .flip-in-right,
    .flip-in-left {
      animation: none;
      opacity: 1;
    }

    .caret {
      animation: none;
    }
  }

  /* 移动端：卡片内边距略收紧 */
  @media (max-width: 480px) {
    .cyber-card {
      padding: 1.5rem 1.4rem 1.3rem;
    }
  }
</style>
